# ---- 数据（本框架不含任何题库数据，这些是导入后产生的） ----
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/_ocr_todo.json
app/index.json

# 数据目录本身要保留（.gitkeep 占位），只忽略里面的内容
data/images/*
data/mock/*
!data/images/.gitkeep
!data/mock/.gitkeep

# ---- 外部资料源（自备考研资料放这里，不要提交） ----
_study/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 本地运行产物 ----
docs/_*.png
docs/_*.json
docs/_*.txt
*.log
_svc.log

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时目录 ----
_tmp/
tmp/
_out/
_backup_*/
_dist/
